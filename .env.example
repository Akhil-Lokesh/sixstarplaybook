# Copy to .env and fill in. Never commit .env. Every value has a local default,
# so for local development you can run with no .env at all (MOCK_LLM=true).

# --- Environment -------------------------------------------------------------
# "production" makes Redis, INTERNAL_TOKEN and ANALYTICS_SALT required.
APP_ENV=production

# --- Claude --------------------------------------------------------------------
# Your key from the Claude Console. Read from the environment only; never put it in code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# low effort with thinking off suits short guide lookups; raise to medium or set
# LLM_THINKING=adaptive if eval answers look thin.
LLM_EFFORT=low
LLM_THINKING=disabled
MAX_OUTPUT_TOKENS=700
# 1h keeps the guide in Claude's prompt cache through quiet stretches; 5m is cheaper to write.
PROMPT_CACHE_TTL=1h
LLM_TIMEOUT_SECONDS=30
# true = offline fake answers (no key, no cost). Use for local wiring and load tests.
MOCK_LLM=false

# --- Redis (Upstash works: use its rediss:// URL) -----------------------------
# Leave empty in docker-compose to use the bundled Redis container.
REDIS_URL=
REDIS_KEY_PREFIX=ssp:

# --- Secrets between services (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))")
INTERNAL_TOKEN=
# Lets you call /admin/* routes and skip per-visitor limits (prefill script). Keep it private.
ADMIN_TOKEN=
ANALYTICS_SALT=

# --- Frontend access -----------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=https://sixstarplaybook.com,https://www.sixstarplaybook.com,http://localhost:5173
# true only when the gateway sits behind Cloudflare or another proxy you control.
TRUST_PROXY_HEADERS=false
SITE_URL=https://sixstarplaybook.com

# --- Limits --------------------------------------------------------------------
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY=30
GLOBAL_AI_REQUESTS_PER_MINUTE=300
EDGE_REQUESTS_PER_MINUTE=120

# --- Spend caps (US dollars). New questions stop when either is reached;
# cached answers keep working. Set these to what you are willing to spend.
DAILY_SPEND_CAP_USD=25
MONTHLY_SPEND_CAP_USD=150
# Reserved per call before Claude answers, then replaced by the real cost.
COST_ESTIMATE_PER_CALL_USD=0.002

# --- Prices per million tokens, used for the spend caps. Check the current
# Claude pricing page and update if they change.
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50
PRICE_CACHE_READ_PER_MTOK=0.01
PRICE_CACHE_WRITE_5M_PER_MTOK=0.125
PRICE_CACHE_WRITE_1H_PER_MTOK=0.20

# --- Answers and content ----------------------------------------------------------
ANSWER_CACHE_TTL_SECONDS=86400
ANSWER_PAGE_TTL_SECONDS=2592000
QUESTION_MAX_CHARS=300
GUIDE_EXCLUDE_SECTIONS=site-name-ideas
GUIDE_REFRESH_SECONDS=60

# Where docker-compose publishes the gateway. Keep 127.0.0.1 behind a reverse proxy
# or Cloudflare Tunnel; use 0.0.0.0:8000 only if the host's firewall is set up.
GATEWAY_PUBLISH=127.0.0.1:8000
